# Copy to `.dev.vars` and fill in values for local development (`npm run dev`).
#
# For production, set the same names with:
#   npx wrangler secret put CLOUDFLARE_API_TOKEN
#   npx wrangler secret put ACCOUNT_ID   # optional

# API token with the "Account Filter Lists: Edit" permission.
CLOUDFLARE_API_TOKEN=

# Optional: only needed when the token can access more than one account.
ACCOUNT_ID=
